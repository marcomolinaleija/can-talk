<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory android:key="@string/pref_brailleime_preferences_category">

    <Preference
        android:key="@string/pref_brailleime_instruction"
        android:summary="@string/summary_pref_brailleime_instruction"
        android:title="@string/title_pref_brailleime_instruction" />

    <Preference
        android:key="@string/pref_brailleime_interactive_tutorial"
        android:summary="@string/summary_pref_brailleime_interactive_tutorial"
        android:title="@string/title_pref_brailleime_interactive_tutorial" />

    <Preference
        android:key="@string/pref_brailleime_turn_on_braille_keyboard"
        android:title="@string/set_up_braille_keyboard" />

    <Preference
        android:key="@string/pref_brailleime_review_all_gestures"
        android:title="@string/review_all_gestures_title" />

    <Preference
        android:key="@string/pref_brailleime_translator_codes_preferred"
        android:summary="%s"
        android:title="@string/preferred_languages_title" />

    <ListPreference
        android:key="@string/pref_brailleime_translator_code"
        android:summary="%s"
        android:title="@string/preferred_typing_language_title" />

    <Preference
        android:key="@string/pref_braille_contracted_mode"
        android:title="@string/preferred_braille_grade_title">
      <intent android:action=".BrailleGradeActivity" />
    </Preference>

    <ListPreference
        android:key="@string/pref_brailleime_layout_mode"
        android:title="@string/context_menu_layout_selection"
        android:summary="%s" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/pref_brailleime_keep_open_after_send"
        android:summary="@string/summary_pref_keep_open_after_send"
        android:title="@string/title_pref_keep_open_after_send" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/pref_brailleime_auto_capitalize"
        android:summary="@string/summary_pref_auto_capitalize"
        android:title="@string/title_pref_auto_capitalize" />

    <Preference
        android:key="@string/pref_brailleime_point_recalibration"
        android:summary="@string/summary_pref_point_recalibration"
        android:title="@string/title_pref_point_recalibration" />

    <SwitchPreferenceCompat
        android:key="@string/pref_brailleime_accumulate_mode"
        android:summary="@string/summary_pref_accumulate_presses"
        android:title="@string/title_pref_accumulate_presses" />

    <SwitchPreferenceCompat
        android:key="@string/pref_brailleime_reverse_dots_mode"
        android:summary="@string/summary_pref_reverse_dots"
        android:title="@string/title_pref_reverse_dots" />

    <SwitchPreferenceCompat
        android:key="@string/pref_brailleime_flip_dots_vertically"
        android:summary="@string/summary_pref_flip_dots_vertically"
        android:title="@string/title_pref_flip_dots_vertically" />

    <SwitchPreferenceCompat
        android:key="@string/pref_brailleime_tablet_held_up_faces_away"
        android:summary="@string/summary_pref_tablet_held_up_faces_away"
        android:title="@string/title_pref_tablet_held_up_faces_away" />

    <SwitchPreferenceCompat
        android:key="@string/pref_brailleime_typing_sounds"
        android:summary="@string/summary_pref_typing_sounds"
        android:title="@string/title_pref_typing_sounds" />

    <ListPreference
        android:key="pref_brailleime_sound_profile"
        android:defaultValue="theme"
        android:dependency="@string/pref_brailleime_typing_sounds"
        android:title="@string/braille_sound_profile_title" />

    <SwitchPreferenceCompat
        android:key="pref_brailleime_sound_follow_reader"
        android:defaultValue="true"
        android:dependency="@string/pref_brailleime_typing_sounds"
        android:title="@string/braille_sound_follow_title"
        android:summary="@string/braille_sound_follow_summary" />

    <SeekBarPreference
        android:key="pref_brailleime_sound_volume"
        android:defaultValue="50"
        android:max="200"
        app:min="0"
        app:showSeekBarValue="true"
        android:title="@string/braille_sound_volume_title"
        android:summary="@string/braille_sound_volume_summary" />

    <Preference
        android:key="pref_brailleime_sound_preview"
        android:dependency="@string/pref_brailleime_typing_sounds"
        android:title="@string/braille_sound_preview_title" />

    <ListPreference
        android:defaultValue="@string/pref_brailleime_keyboard_echo_default"
        android:entries="@array/pref_brailleime_keyboard_echo_entries"
        android:entryValues="@array/pref_brailleime_keyboard_echo_values"
        android:key="@string/pref_brailleime_keyboard_echo"
        android:summary="%s"
        android:title="@string/title_pref_braille_keyboard_echo" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="@string/pref_brailleime_voice_allow_profanity"
        android:summary="@string/summary_pref_voice_allow_profanity"
        android:title="@string/title_pref_voice_allow_profanity" />

    <Preference
        android:key="@string/pref_brailleime_system_voice_settings"
        android:summary="@string/summary_pref_system_voice_settings"
        android:title="@string/title_pref_system_voice_settings" />

  </PreferenceCategory>

</PreferenceScreen>
