<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" xmlns:tools="http://schemas.android.com/tools">
    <!-- New updater labels are localized in English and Spanish; other locales use English. -->
    <string name="title_pref_release_notes" tools:ignore="MissingTranslation">What is new</string>
    <string name="update_version_notification_text" tools:ignore="MissingTranslation">Version %1$s. Tap to install.</string>
    <string name="update_version_dialog_title" tools:ignore="MissingTranslation">CAN Talk %1$s is available</string>
    <string name="update_release_notes_title" tools:ignore="MissingTranslation">What is new in CAN Talk %1$s</string>
    <!-- Title of the setting that checks GitHub for a newer development build of CAN Talk. [CHAR LIMIT=40] -->
    <string name="title_pref_check_for_updates">Check for updates</string>
    <!-- Summary of the check for updates setting, with the version of the running app. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_check_for_updates">Version <xliff:g id="version" example="1.0.3">%1$s</xliff:g></string>
    <!-- Title of the switch that turns daily update checks on or off. [CHAR LIMIT=40] -->
    <string name="title_pref_auto_update_check">Automatically check for updates</string>
    <!-- Summary of the automatic update check switch. [CHAR LIMIT=NONE] -->
    <string name="summary_pref_auto_update_check">Check once a day and show a notification when a new build is available</string>

    <!-- Title of the notification that says a new build is available. [CHAR LIMIT=NONE] -->
    <string name="update_notification_title">CAN Talk update available</string>
    <!-- Button in the update dialog that downloads and installs the new build. [CHAR LIMIT=20] -->
    <string name="update_dialog_install">Install</string>

    <!-- Toast shown when a manual update check starts. [CHAR LIMIT=NONE] -->
    <string name="update_checking">Checking for updates</string>
    <!-- Toast shown when a manual update check finds no newer build. [CHAR LIMIT=NONE] -->
    <string name="update_up_to_date">CAN Talk is up to date</string>
    <!-- Toast shown when an update check fails. [CHAR LIMIT=NONE] -->
    <string name="update_check_failed">Could not check for updates</string>
    <!-- Toast shown when the update download starts. [CHAR LIMIT=NONE] -->
    <string name="update_downloading">Downloading update</string>
    <!-- Toast shown when the update cannot be downloaded or installed. [CHAR LIMIT=NONE] -->
    <string name="update_install_failed">Could not install the update</string>
    <!-- Toast shown when the user cancels the install. [CHAR LIMIT=NONE] -->
    <string name="update_install_canceled">Update canceled</string>
    <!-- Toast shown with the settings screen where the user allows CAN Talk to install apps. [CHAR LIMIT=NONE] -->
    <string name="update_allow_install">Allow CAN Talk to install apps, then try the update again</string>
</resources>
